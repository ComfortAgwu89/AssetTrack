# Copy to backend/.env and fill in. Never commit the real file.

# Flask
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-a-different-long-random-string

# PostgreSQL (create the database first, see README)
DATABASE_URL=postgresql+psycopg2://assettrack_user:YOUR_DB_PASSWORD@localhost:5432/assettrack

# Cookies: set to true when served over HTTPS (production)
JWT_COOKIE_SECURE=false

# Demo seed password for the demo accounts (development only)
DEMO_PASSWORD=ChangeThisDemoPassword1
